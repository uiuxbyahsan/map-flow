{
  "rules": {
    "officers": {
      ".read": true,
      "$officerId": {
        ".write": true,
        ".validate": "newData.hasChildren(['lat', 'lng', 'updatedAt'])",
        "lat": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },
        "lng": {
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "pins": {
      ".read": true,
      "$pinId": {
        ".write": true,
        ".validate": "newData.hasChildren(['type', 'label', 'createdAt']) && (((!newData.child('shapeType').exists() || newData.child('shapeType').val() === 'point') && newData.hasChildren(['lat', 'lng'])) || (newData.child('shapeType').val() === 'circle' && newData.hasChildren(['lat', 'lng', 'radiusMeters'])) || ((newData.child('shapeType').val() === 'polygon' || newData.child('shapeType').val() === 'rectangle') && newData.hasChildren(['coordinates'])))",
        "shapeType": {
          ".validate": "newData.val() === 'point' || newData.val() === 'polygon' || newData.val() === 'rectangle' || newData.val() === 'circle'"
        },
        "type": {
          ".validate": "newData.val() === 'incident' || newData.val() === 'checkpoint' || newData.val() === 'patrol' || newData.val() === 'cordon' || newData.val() === 'search_zone' || newData.val() === 'other'"
        },
        "label": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
        },
        "note": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "lat": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },
        "lng": {
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        },
        "radiusMeters": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 100000"
        },
        "coordinates": {
          "$i": {
            ".validate": "newData.hasChildren(['lat', 'lng'])",
            "lat": {
              ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
            },
            "lng": {
              ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
