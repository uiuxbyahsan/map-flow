# Firebase web app config (Firebase console → Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Admin view is served at /admin-<slug>. Pick a long random slug (16+ chars, letters/digits/-/_):
#   openssl rand -hex 12
# Only its SHA-256 hash goes here, so the slug itself never appears in the deployed JS:
#   printf %s '<slug>' | shasum -a 256
# If unset or invalid, the admin view is disabled.
VITE_ADMIN_SLUG_HASH=
